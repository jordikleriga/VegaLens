# ============================================
# VegaLens - Elasticsearch Connection Configuration
# ============================================
# This file configures the "Development" connection mode.
# Users can also connect directly via the UI using Serverless, Cloud, or Self-Hosted modes.
#
# Choose ONE of the following connection methods:

# --------------------------------------------
# OPTION 1: Elasticsearch Serverless
# --------------------------------------------
# Find your Elasticsearch endpoint in the Elastic Cloud console:
# Go to: Cloud Console → Your Project → Endpoints → Elasticsearch
# IMPORTANT: Use the .es. endpoint, NOT the .kb. (Kibana) endpoint!
# Example: https://your-project-id.es.us-central1.gcp.elastic.cloud
#
# ELASTIC_SERVERLESS_ENDPOINT=https://your-project-id.es.us-central1.gcp.elastic.cloud
# ELASTIC_API_KEY=your-api-key-here

# --------------------------------------------
# OPTION 2: Elastic Cloud (Standard/Non-Serverless)
# --------------------------------------------
# Cloud ID is found in: Cloud Console → Deployment → Manage → Cloud ID
#
# Authentication: Use API Key OR Username/Password (not both)
#
# ELASTIC_CLOUD_ID=deployment-name:base64encodedstring
# ELASTIC_API_KEY=your-api-key-here
#
# Or with username/password:
# ELASTIC_CLOUD_ID=deployment-name:base64encodedstring
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-password

# --------------------------------------------
# OPTION 3: Self-Hosted / On-Premise
# --------------------------------------------
# Direct connection to your Elasticsearch instance
#
# Authentication: Use API Key OR Username/Password (not both)
#
# ELASTIC_NODE=https://your-elasticsearch:9200
# ELASTIC_API_KEY=your-api-key-here
#
# Or with username/password:
# ELASTIC_NODE=https://your-elasticsearch:9200
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-password
#
# For self-signed certificates (development only):
# ELASTIC_SKIP_TLS=true

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# CORS - allowed origins for frontend
CORS_ORIGIN=http://localhost:5173

# ============================================
# Logging Configuration
# ============================================
# Log levels: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
