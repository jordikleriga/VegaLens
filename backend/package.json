{
  "name": "vega-dashboard-builder-api",
  "version": "1.0.0",
  "description": "Express API for Vega Dashboard Builder with Elasticsearch integration",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node tests/runTests.js",
    "test:coverage": "c8 npm test",
    "test:coverage:report": "c8 report --reporter=html && open coverage/index.html",
    "test:direct": "node tests/chartTypes.test.js",
    "test:watch": "nodemon --watch tests --watch src tests/chartTypes.test.js",
    "test:schema": "node tests/spec-validation/run.js",
    "test:queries": "node tests/query-validation/run.js",
    "test:visual": "node tests/visual-regression/run.js",
    "test:visual:update": "node tests/visual-regression/run.js --update",
    "test:all-tiers": "node tests/run-all-tiers.js",
    "test:ci": "node tests/run-all-tiers.js --skip-tier3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "ajv": "^8.17.1",
    "c8": "^10.1.3",
    "canvas": "^3.2.0",
    "nodemon": "^3.0.2",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.40.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.34.0",
    "sharp": "^0.33.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
