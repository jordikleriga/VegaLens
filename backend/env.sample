# ============================================
# Elasticsearch Connection Configuration
# ============================================
# Choose ONE of the following connection methods:

# --------------------------------------------
# OPTION 1: Elasticsearch Serverless (Recommended for Serverless)
# --------------------------------------------
# Find your Elasticsearch endpoint in the Elastic Cloud console:
# Go to: Cloud Console → Your Project → Endpoints → Elasticsearch
# It looks like: https://your-project-id.es.region.aws.elastic.cloud
ELASTIC_SERVERLESS_ENDPOINT=https://your-project-id.es.us-east-1.aws.elastic.cloud
ELASTIC_API_KEY=your-api-key-here

# --------------------------------------------
# OPTION 2: Elastic Cloud (Standard/Non-Serverless)
# --------------------------------------------
# Cloud ID is found in: Cloud Console → Deployment → Manage → Cloud ID
# ELASTIC_CLOUD_ID=deployment-name:base64encodedstring
# ELASTIC_API_KEY=your-api-key-here

# --------------------------------------------
# OPTION 3: On-Premise / Self-Hosted
# --------------------------------------------
# ELASTIC_NODE=https://localhost:9200
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=your-password
# ELASTIC_SKIP_TLS=true  # Only for self-signed certs in dev

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# ============================================
# Logging Configuration
# ============================================
# Log levels: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
